ARMORIQ_API_KEY=
FINANCEGUARD_USER_EMAIL=demo@example.com
FINANCEGUARD_PORT=8001
FIREBASE_PROJECT_ID=asmoneykit
# Enable only after this workspace-scoped MCP origin is registered in ArmorIQ:
FINANCEGUARD_SCOPED_MCP=0
# Optional test-only, operator-scoped Stripe connector:
STRIPE_SECRET_KEY=
STRIPE_OPERATOR_EMAIL=
# Add exact deployment hostnames when hosting; no schemes or paths:
FINANCEGUARD_ALLOWED_HOSTS=
FINANCEGUARD_HTTPS=0

# Must match the organization selected in the ArmorIQ console:
ARMORIQ_EXPECTED_ORG_ID=68c3541d-e2d8-462a-8393-243925a5ed23
ARMORIQ_AGENT_ID=financeguard-demo
ARMORIQ_OBSERVABILITY=true
# Exact public HTTPS /mcp URL registered in ArmorIQ (no credentials):
MCP_SERVER_URL=
