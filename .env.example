ARMORIQ_API_KEY=
# Backend only: the conversation assistant uses OpenRouter tool calling.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
FINANCEGUARD_USER_EMAIL=demo@example.com
FINANCEGUARD_PORT=8001
FIREBASE_PROJECT_ID=asmoneykit
# Required=1 for ArmorIQ; enable after origin registration and shared data/grants:
FINANCEGUARD_SCOPED_MCP=0
# Optional test-only, operator-scoped Stripe connector:
STRIPE_SECRET_KEY=
STRIPE_OPERATOR_EMAIL=
# Add exact deployment hostnames when hosting; no schemes or paths:
FINANCEGUARD_ALLOWED_HOSTS=
FINANCEGUARD_HTTPS=0

# Must match the organization selected in the ArmorIQ console:
ARMORIQ_EXPECTED_ORG_ID=68c3541d-e2d8-462a-8393-243925a5ed23
# Existing registry agent UUID supplied by owner; SDK/policy linkage still needs verification.
ARMORIQ_AGENT_ID=0b925302-bb1d-4e44-908a-e67869e52db9
# Existing MCP dashboard record supplied by the project owner:
ARMORIQ_MCP_SERVER_ID=2da563ef-544e-4db7-a418-0c404cf75180
ARMORIQ_OBSERVABILITY=true
# Exact public HTTPS /mcp URL registered in ArmorIQ (no credentials):
MCP_SERVER_URL=
# Private shared signing key (32+ random characters). Shared grants/data also required:
FINANCEGUARD_MCP_SIGNING_KEY=

# Invoice provider connections: persistent backend only, never frontend variables.
# Fernet key: generate once and preserve it; local development uses runtime key file.
FINANCEGUARD_CONNECTOR_KEY=
# Register a Zoho Server-based Application; READ invoice scope only.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Must exactly match the callback registered in Zoho; use your actual backend host.
ZOHO_REDIRECT_URI=
